.ops-intelligence
  --ops-accent #7c6df2
  --ops-accent-soft rgba(124, 109, 242, .13)
  --ops-green #48c78e
  --ops-warning #e6a23c
  min-height 100%
  padding-bottom 148px
  color var(--text)

.ops-overview
  margin -10px -10px 0
  padding 18px 18px 14px
  background linear-gradient(145deg, var(--ops-accent-soft), transparent 72%)
  border-bottom 1px solid var(--main-darker)

.ops-live-title
  display flex
  align-items center
  gap 11px
  .ops-ai-orb
    display grid
    place-items center
    width 38px
    height 38px
    border-radius 12px
    color #fff
    font-size 18px
    background linear-gradient(145deg, #8d7cf7, #5748c8)
    box-shadow 0 6px 22px rgba(87, 72, 200, .3)
  > div
    display flex
    flex-direction column
    gap 3px
  strong
    font-size 14px
  small
    color var(--text-light)
    font-size 11px
    i
      display inline-block
      width 6px
      height 6px
      margin-right 5px
      border-radius 50%
      background var(--ops-green)
      box-shadow 0 0 8px var(--ops-green)

.ops-kpis
  display grid
  grid-template-columns repeat(3, 1fr)
  gap 7px
  margin-top 15px
  > div
    display flex
    min-height 58px
    padding 9px 10px
    flex-direction column
    justify-content center
    border 1px solid var(--main-darker)
    border-radius 8px
    background rgba(0, 0, 0, .08)
    strong
      font-size 19px
      line-height 1
    small
      margin-top 6px
      color var(--text-light)
      font-size 10px
  .ops-score
    flex-direction row
    align-items center
    justify-content flex-start
    gap 8px
    .ant-progress-text
      font-size 9px
    small
      max-width 34px
      margin 0

.ops-capture-toggle
  display flex
  align-items center
  justify-content space-between
  margin-top 12px
  > span
    display flex
    align-items center
    gap 8px
    > .anticon
      color var(--ops-green)
    > span
      display flex
      flex-direction column
  strong
    font-size 11px
  small
    color var(--text-light)
    font-size 9px

.ops-section-tabs
  position sticky
  top -10px
  z-index 5
  display grid
  grid-template-columns repeat(3, 1fr)
  margin 0 -10px 10px
  background var(--main)
  border-bottom 1px solid var(--main-darker)
  button
    position relative
    height 43px
    border 0
    color var(--text-light)
    background transparent
    cursor pointer
    font-size 11px
    transition .2s
    .anticon
      margin-right 5px
    &::after
      content ''
      position absolute
      left 18%
      right 18%
      bottom -1px
      height 2px
      opacity 0
      background var(--ops-accent)
      transform scaleX(.4)
      transition .2s
    &:hover
      color var(--text)
      background rgba(124, 109, 242, .05)
    &.active
      color var(--text)
      &::after
        opacity 1
        transform scaleX(1)
    i
      position absolute
      width 5px
      height 5px
      margin 0 0 0 3px
      border-radius 50%
      background #f06464

.ops-card-list
  display flex
  flex-direction column
  gap 10px

.ops-diagnosis-card
.ops-knowledge-card
  padding 14px
  border 1px solid var(--main-darker)
  border-radius 9px
  background var(--main)
  box-shadow 0 6px 18px rgba(0, 0, 0, .06)
  &.severity-critical
    border-left 3px solid #e75757
  &.severity-warning
    border-left 3px solid var(--ops-warning)
  &.severity-info
    border-left 3px solid #4f9ee8
  h3
    margin 10px 0 6px
    font-size 14px
    line-height 1.45
  > p
    margin 0 0 12px
    color var(--text-light)
    font-size 11px
    line-height 1.7

.ops-card-topline
  display flex
  align-items center
  gap 6px
  color var(--text-light)
  font-size 10px
  time
    margin-left auto
  .ant-tag
    margin 0
    font-size 9px
    line-height 18px

.ops-command-origin
  display flex
  align-items center
  gap 7px
  min-width 0
  padding 8px 9px
  border-radius 5px
  color var(--text-light)
  background rgba(0, 0, 0, .13)
  .anticon
    flex 0 0 auto
  code
    flex 1
    overflow hidden
    color var(--text)
    font-size 10px
    text-overflow ellipsis
    white-space nowrap
  em
    flex 0 0 auto
    color #e26f6f
    font-size 9px
    font-style normal

.ops-evidence
  margin-top 9px
  summary
    color var(--text-light)
    cursor pointer
    font-size 10px
    .anticon
      margin-right 5px
  pre
    max-height 170px
    margin 8px 0 0
    padding 9px
    overflow auto
    border-radius 5px
    color var(--text-light)
    background rgba(0, 0, 0, .18)
    font-size 9px
    line-height 1.5
    white-space pre-wrap

.ops-suggestions
  margin-top 12px
  small
    display block
    margin-bottom 6px
    color var(--text-light)
    font-size 9px
    text-transform uppercase
    letter-spacing .08em
  button
    display flex
    width 100%
    align-items center
    gap 7px
    margin-top 4px
    padding 7px 8px
    border 1px solid transparent
    border-radius 5px
    color var(--text)
    background rgba(124, 109, 242, .08)
    cursor pointer
    text-align left
    transition .2s
    code
      flex 1
      overflow hidden
      font-size 9px
      text-overflow ellipsis
      white-space nowrap
    .anticon
      color var(--ops-accent)
    &:hover
      border-color rgba(124, 109, 242, .35)
      background rgba(124, 109, 242, .14)

.ops-card-actions
  display flex
  align-items center
  gap 6px
  margin-top 12px
  > span
    margin-left auto
    color var(--text-light)
    font-size 9px

.ops-timeline
  position relative
  padding 2px 0 0 8px
  &::before
    content ''
    position absolute
    left 17px
    top 15px
    bottom 20px
    width 1px
    background var(--main-darker)
  article
    position relative
    display grid
    grid-template-columns 20px 1fr
    gap 10px
    padding-bottom 17px
    &.failed .timeline-node
      color #e76565
      border-color rgba(231, 101, 101, .4)
    &:not(.failed) .timeline-node
      color var(--ops-green)
      border-color rgba(72, 199, 142, .35)

.timeline-node
  position relative
  z-index 1
  display grid
  place-items center
  width 20px
  height 20px
  border 1px solid
  border-radius 50%
  background var(--main)
  font-size 9px

.timeline-content
  min-width 0
  padding 0 8px 10px 0
  > code
    display block
    margin 7px 0
    overflow hidden
    color var(--text)
    font-size 11px
    line-height 1.5
    text-overflow ellipsis
    white-space nowrap
  details
    margin-top 8px
    color var(--text-light)
    font-size 9px
    summary
      cursor pointer
    pre
      max-height 150px
      margin 7px 0 0
      padding 8px
      overflow auto
      border-radius 5px
      background rgba(0, 0, 0, .14)
      white-space pre-wrap

.timeline-meta
  display flex
  align-items center
  gap 7px
  color var(--text-light)
  font-size 9px
  span
    color var(--text)
  em
    margin-left auto
    font-style normal

.timeline-labels
  .ant-tag
    margin-right 4px
    font-size 8px
    line-height 16px

.ops-knowledge-wrap
  > .ant-input-affix-wrapper
    margin-bottom 10px

.ops-knowledge-card
  border-left 3px solid var(--ops-accent)
  .knowledge-source
    display flex
    justify-content space-between
    color var(--text-light)
    font-size 9px
    span .anticon
      margin-right 5px
      color var(--ops-accent)

.knowledge-block
  margin-top 9px
  padding 8px 9px
  border-radius 5px
  background rgba(230, 162, 60, .08)
  small
    display block
    margin-bottom 4px
    color var(--ops-warning)
    font-size 9px
  span
    display block
    color var(--text-light)
    font-size 10px
    line-height 1.55
  &.success
    background rgba(72, 199, 142, .08)
    small
      color var(--ops-green)

.knowledge-commands
  margin-top 9px
  summary
    color var(--text-light)
    cursor pointer
    font-size 10px
  code
    display block
    margin-top 4px
    padding 6px 7px
    overflow hidden
    border-radius 4px
    background rgba(0, 0, 0, .12)
    font-size 9px
    text-overflow ellipsis
    white-space nowrap

.knowledge-footer
  display flex
  align-items center
  justify-content space-between
  margin-top 10px
  .ant-tag
    margin 2px 3px 0 0
    font-size 8px
    line-height 16px

.ops-empty
  padding 25px 24px
  text-align center
  .ant-empty
    margin-bottom 0
  strong
    display block
    margin-top -4px
    font-size 13px
  p
    margin 7px 0 0
    color var(--text-light)
    font-size 10px
    line-height 1.65

.ops-summary-bar
  position absolute
  z-index 6
  left 10px
  right 10px
  bottom 10px
  padding-top 10px
  background linear-gradient(transparent, var(--main) 12px)
  .ant-btn
    margin-top 8px
    font-size 12px

.ops-privacy-banner
  display flex
  gap 9px
  padding 9px 10px
  border 1px solid var(--main-darker)
  border-radius 6px
  background var(--main)
  > .anticon
    margin-top 2px
    color var(--ops-green)
  > div
    display flex
    flex-direction column
    gap 2px
  strong
    font-size 9px
  span
    color var(--text-light)
    font-size 8px
    line-height 1.45
